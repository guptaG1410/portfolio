# Public site URL used for metadata, Open Graph, and the sitemap.
# Example: https://govindgupta.dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Your LeetCode profile. Leave blank until you have the exact URL.
# The site will not invent one.
NEXT_PUBLIC_LEETCODE_URL=

# Availability indicator in the hero. This is a manual setting, not inferred from the resume.
# Set the flag to false to hide it. Edit the label to match your actual status.
NEXT_PUBLIC_AVAILABILITY_SHOW=true
NEXT_PUBLIC_AVAILABILITY_LABEL=Open to opportunities

# Contact form delivery via Resend (https://resend.com).
# Until all three values are set, the form does not pretend a message was sent.
# It explains that delivery is not configured and offers a mailto link instead.
#
# Testing without a custom domain: Resend lets onboarding@resend.dev send only
# to the email address on your Resend account.
# RESEND_API_KEY=re_xxxxxxxx
# CONTACT_FROM_EMAIL=onboarding@resend.dev
# CONTACT_TO_EMAIL=guptagovind1410@gmail.com
#
# Production: verify your domain in Resend, then use an address on that domain.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=guptagovind1410@gmail.com
